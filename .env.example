# Public Firebase browser configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Surge uses the OpenAI Responses API on the server. Keep the API key only as a
# protected Sites runtime secret. The model ID is non-secret and can be changed
# without rebuilding the application.
OPENAI_API_KEY=
SURGE_MODEL=gpt-5.6-sol
SURGE_AI_ENABLED=true
SURGE_USAGE_GUARD_SECRET=
SURGE_CLIENT_MINUTE_LIMIT=20
SURGE_CLIENT_DAILY_LIMIT=200
SURGE_NETWORK_MINUTE_LIMIT=120
SURGE_NETWORK_DAILY_LIMIT=2000
SURGE_GLOBAL_MINUTE_LIMIT=120
SURGE_GLOBAL_INFLIGHT_LIMIT=20
SURGE_GLOBAL_DAILY_MICRO_USD=100000000

# Server-side Australian address search. Google Geocoding is supported directly;
# another approved provider can return the documented suggestions contract.
TLINK_ADDRESS_AUTOCOMPLETE_ENDPOINT=https://maps.googleapis.com/maps/api/geocode/json
TLINK_ADDRESS_AUTOCOMPLETE_TOKEN=

# Customer service reminder providers. Store API keys and webhook signing values
# only as protected Sites runtime secrets. Resend requires a verified sending
# domain. Twilio requires a Messaging Service, Verify Service and Australian sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TLINK_FIELD_PIN_PEPPER=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
SERVICE_REMINDER_TWILIO_CALLBACK_URL=https://compare.ausenergyassessments.com/api/service-reminder-provider-events/twilio

# Long-running official product maintenance is machine-authenticated separately
# from signed-in calculator use. Generate at least 32 random bytes and keep the
# value only in the protected Sites runtime environment.
CREDITEX_PRODUCT_REGISTRY_MAINTENANCE_TOKEN=

# TLink business integrations. Register one central OAuth application with each
# provider and keep every client secret and the encryption key in protected Sites
# runtime variables. Each callback must match the provider registration exactly.
CRM_INTEGRATION_ENCRYPTION_KEY=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Register these exact production callbacks with the matching provider:
# https://compare.ausenergyassessments.com/api/trade-integrations/callback/xero
# https://compare.ausenergyassessments.com/api/trade-integrations/callback/myob
# https://compare.ausenergyassessments.com/api/trade-integrations/callback/quickbooks
# https://compare.ausenergyassessments.com/api/trade-integrations/callback/google_calendar
# https://compare.ausenergyassessments.com/api/trade-integrations/callback/microsoft_calendar
