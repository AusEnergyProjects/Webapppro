{
  "name": "aea-energy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && npm run audit:sites-server-bundle && npm run audit:public-performance",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:customer-plan-pdf": "node scripts/audit-customer-plan-pdf.mjs",
    "audit:public-performance": "node scripts/audit-public-performance-budgets.mjs",
    "audit:surge-conversation-quality": "node --experimental-strip-types scripts/report-surge-conversation-quality.mjs",
    "audit:surge-source-approvals": "node --experimental-strip-types scripts/audit-energy-assistant-source-approvals.mjs",
    "audit:surge-source-custody": "node --experimental-strip-types scripts/audit-energy-assistant-official-source-custody.mjs",
    "audit:surge-assessor-education": "node --experimental-strip-types scripts/audit-surge-assessor-education.mjs",
    "capture:surge-official-sources": "node --experimental-strip-types scripts/capture-energy-assistant-official-sources.mjs",
    "audit:sites-server-bundle": "node scripts/audit-sites-server-bundle.mjs",
    "benchmark:scale": "node scripts/benchmark-scale-100k.mjs",
    "rehearse:surge-continuity": "node --experimental-strip-types scripts/rehearse-surge-context-continuity.mjs",
    "rehearse:surge-browser-continuity": "node scripts/rehearse-surge-browser-continuity.mjs",
    "validate:creditex-certificate-activation": "node --experimental-strip-types scripts/validate-creditex-certificate-activation.mjs",
    "start": "vinext start",
    "lint": "eslint --concurrency 4",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --experimental-strip-types --test",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test",
    "test:integration": "node --experimental-strip-types --test test/australian-postcodes.test.mjs test/direct-trade-matching.test.mjs test/gas-tariff-engine.test.mjs test/home-energy-plan.test.mjs test/release-integrity.test.mjs test/trade-payment-reconciliation.test.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "validate": "npm run typecheck && npm run lint && npm run audit:surge-source-approvals && npm run audit:surge-source-custody && npm run audit:surge-assessor-education && npm run audit:surge-conversation-quality && npm run rehearse:surge-continuity && npm run test:integration && npm test && npm run db:check && npm run audit:customer-plan-pdf && npm run build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.7.4",
    "firebase": "^12.16.0",
    "jose": "^6.2.3",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "1.8.1",
    "vinext": "0.0.50"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright-core": "^1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.1.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
