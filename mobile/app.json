{
  "expo": {
    "name": "TLink",
    "slug": "aea-field",
    "version": "1.3.4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aeafield",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06131f",
    "primaryColor": "#07182b",
    "description": "Simple, secure TLink schedules and field workflows for technicians, trades and assessors.",
    "ios": {
      "bundleIdentifier": "au.com.australianenergyassessments.field",
      "buildNumber": "3",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "au.com.australianenergyassessments.field",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#07182b",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06131f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow TLink to unlock protected offline work."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TLink to attach job photos.",
          "cameraPermission": "Allow TLink to take photos and join team video calls.",
          "microphonePermission": "Allow TLink to make team calls and record voice messages."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TLink to record the installation location with field evidence.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-background-task",
      "expo-image",
      "expo-web-browser",
      "./plugins/with-tlink-calls",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TLink to make team calls and record voice messages.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow TLink to take photos and join team video calls.",
          "microphonePermission": "Allow TLink to make team calls and record voice messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b02565e-dc34-4088-8cdd-e3c8a9ba11e9"
      }
    },
    "owner": "ausenergy",
    "updates": {
      "url": "https://u.expo.dev/3b02565e-dc34-4088-8cdd-e3c8a9ba11e9"
    }
  }
}
