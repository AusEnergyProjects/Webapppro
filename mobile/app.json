{
  "expo": {
    "name": "TLink Field",
    "slug": "aea-field",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aeafield",
    "userInterfaceStyle": "light",
    "description": "Simple, secure TLink schedules and field workflows for technicians, trades and assessors.",
    "ios": {
      "bundleIdentifier": "au.com.australianenergyassessments.field",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "au.com.australianenergyassessments.field",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#063a31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#063a31",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow TLink Field to unlock protected offline work."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TLink Field to attach job photos.",
          "cameraPermission": "Allow TLink Field to photograph job progress and evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TLink Field to record the installation location with field evidence.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-background-task",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b02565e-dc34-4088-8cdd-e3c8a9ba11e9"
      }
    },
    "owner": "ausenergy",
    "updates": {
      "url": "https://u.expo.dev/3b02565e-dc34-4088-8cdd-e3c8a9ba11e9"
    }
  }
}
